# Synthia 平台沙箱环境变量（复制为 env.real 并按需修改；勿提交仓库）
# 嵌入式 PG 以 trust 认证监听 127.0.0.1:5432（沙箱网络隔离内的回环，无密码）。

# 必填：core API
DATABASE_URL=postgres://synthia@127.0.0.1:5432/synthia
PORT=8000
# 平台沙箱预览代理经容器网络访问后端 → 必须绑 0.0.0.0（不设则默认 127.0.0.1）
SYNTHIA_CORE_HOST=0.0.0.0
SYNTHIA_RUNTIME_URL=none
SYNTHIA_CONNECTOR_CONFIG=./worker-66.config.json
# 沙箱等受限环境用部署目录内路径（30-start.sh 缺省即 $PWD/synthia-data/workspaces）
# SYNTHIA_WORKSPACES_DIR=

# 选填：Vivado connector 链路（不带则 connector 503 降级；值从家里受控密钥存储取）
# SYNTHIA_CF_ACCESS_CLIENT_ID=
# SYNTHIA_CF_ACCESS_CLIENT_SECRET=
