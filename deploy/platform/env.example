# Synthia 平台沙箱环境变量（复制为 env.real 并按需修改；勿提交仓库）
# 嵌入式 PG 以 trust 认证监听 127.0.0.1:5432（沙箱网络隔离内的回环，无密码）。

# 必填：core API
DATABASE_URL=postgres://synthia@127.0.0.1:5432/synthia
PORT=8000
# 平台沙箱预览代理经容器网络访问后端 → 必须绑 0.0.0.0（不设则默认 127.0.0.1）
SYNTHIA_CORE_HOST=0.0.0.0
# phase 2：runtime 任务服务（core 经此下放任务；loopback 即可，无需对外）
SYNTHIA_RUNTIME_URL=http://127.0.0.1:8790
SYNTHIA_RUNTIME_MODE=core
SYNTHIA_RUNTIME_PORT=8790
SYNTHIA_CORE_URL=http://127.0.0.1:8000
SYNTHIA_CORE_TOKEN=<SERVICE_TOKEN，见部署说明>
SYNTHIA_TASK_RUNTIME_TOKEN=<TASK_RUNTIME_TOKEN，见部署说明>
# 模型：智谱 GLM（Anthropic 兼容端点，公网可达）
SYNTHIA_MODEL_URL=https://open.bigmodel.cn/api/anthropic
SYNTHIA_MODEL_API=anthropic-messages
SYNTHIA_MODEL_NAME=glm-4.6
SYNTHIA_MODEL_CHAT_MAX_TOKENS=65536
SYNTHIA_MODEL_TOOL_MAX_TOKENS=32768
SYNTHIA_MODEL_DOC_MAX_TOKENS=49152
SYNTHIA_MODEL_KEY=<智谱 API key，必填>
SYNTHIA_RUNS_DIR=/task/apps/project/synthia-data/runs
SYNTHIA_CONNECTOR_CONFIG=./worker-66.config.json
# 沙箱等受限环境用部署目录内路径（30-start.sh 缺省即 $PWD/synthia-data/workspaces）
# SYNTHIA_WORKSPACES_DIR=

# 选填：Vivado connector 链路（不带则 connector 503 降级；值从家里受控密钥存储取）
# SYNTHIA_CF_ACCESS_CLIENT_ID=
# SYNTHIA_CF_ACCESS_CLIENT_SECRET=
